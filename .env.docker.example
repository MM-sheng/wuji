# Public configuration and file paths only. Never put private keys or passwords here.
MANIFEST=contracts/deployments/sepolia-weth-v3.json
WUJI_PORT=8794
RPC=https://ethereum-sepolia.publicnode.com
BITCOIN_API=https://mempool.space/api,https://blockstream.info/api
# Optional keeper profile: supply a NEW independently funded testnet operator account.
KEYSTORE_ACCOUNT=wuji-operator
KEYSTORE_FILE=/absolute/path/to/encrypted-keystore.json
PASSWORD_FILE=/absolute/path/to/password-file
# Container user is uid 1000. On Linux, grant that uid read access to these two files;
# do not make passwords world-readable. Mounts are read-only and never included in builds.
